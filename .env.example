# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gocrm
DB_USER=root
DB_PASSWORD=
DB_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_MODE=development

# JWT Configuration
# CRITICAL: JWT_SECRET must be:
#  - At least 32 characters long
#  - Unique and random
#  - Never committed to version control
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
JWT_EXPIRY_HOURS=24

# Refresh token lifetime in days (default 30). Refresh tokens are opaque
# random values stored only as HMAC-SHA256 hashes; presenting one at
# POST /auth/refresh rotates it (the old token is revoked, a new one issued).
# JWT_REFRESH_TOKEN_DAYS is honoured as a legacy fallback if this is unset.
# REFRESH_TOKEN_EXPIRY_DAYS=30

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# API Configuration
API_PREFIX=/api/v1

# API Key HMAC Secret (optional)
# Used for HMAC-SHA256 hashing of API keys. Falls back to JWT_SECRET if not set.
# Generate a secure secret with: openssl rand -base64 32
# API_KEY_SECRET=CHANGE_THIS_TO_A_SEPARATE_SECRET_FOR_API_KEY_HASHING
# Outbound email (password reset links)
# When SMTP_HOST is empty, no mail is sent: the mailer falls back to logging
# the delivery (recipient + reset link with the token redacted). Set SMTP_HOST
# to enable real delivery via net/smtp; SMTP_USER/SMTP_PASSWORD are optional
# (PLAIN auth is used only when SMTP_USER is set).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@localhost

# Public base URL of the frontend, used to build password reset links as
# APP_BASE_URL/reset-password?token=... (no trailing slash needed).
# APP_BASE_URL=http://localhost:5173

# Testing
# Bypasses ONLY the strict rate-limit tier on auth endpoints so the E2E suite
# can log in repeatedly. Moderate/generous tiers remain active. Never enable in production.
# DISABLE_RATE_LIMIT=true

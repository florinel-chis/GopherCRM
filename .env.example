# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gocrm
DB_USER=root
DB_PASSWORD=
DB_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_MODE=development

# Extra CORS origins, comma-separated, allowed in addition to the built-in
# development defaults (localhost 5173/3000/8080). Needed whenever the UI is
# served from any other origin — the backend answers a bare 403 to requests
# whose Origin header is not allowlisted.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# JWT Configuration
# CRITICAL: JWT_SECRET must be:
#  - At least 32 characters long
#  - Unique and random
#  - Never committed to version control
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
JWT_EXPIRY_HOURS=24

# Refresh token lifetime in days (default 30). Refresh tokens are opaque
# random values stored only as HMAC-SHA256 hashes; presenting one at
# POST /auth/refresh rotates it (the old token is revoked, a new one issued).
# JWT_REFRESH_TOKEN_DAYS is honoured as a legacy fallback if this is unset.
# REFRESH_TOKEN_EXPIRY_DAYS=30

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# API Configuration
API_PREFIX=/api/v1

# API Key HMAC Secret (optional)
# Used for HMAC-SHA256 hashing of API keys. Falls back to JWT_SECRET if not set.
# Generate a secure secret with: openssl rand -base64 32
# API_KEY_SECRET=CHANGE_THIS_TO_A_SEPARATE_SECRET_FOR_API_KEY_HASHING
# Outbound email (password reset links)
# When SMTP_HOST is empty, no mail is sent: the mailer falls back to logging
# the delivery (recipient + reset link with the token redacted). Set SMTP_HOST
# to enable real delivery via net/smtp; SMTP_USER/SMTP_PASSWORD are optional
# (PLAIN auth is used only when SMTP_USER is set).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@localhost

# Public base URL of the frontend, used to build password reset links as
# APP_BASE_URL/reset-password?token=... (no trailing slash needed).
# APP_BASE_URL=http://localhost:5173

# Testing
# Bypasses ONLY the strict rate-limit tier on auth endpoints so the E2E suite
# can log in repeatedly. Moderate/generous tiers remain active. Never enable in production.
# DISABLE_RATE_LIMIT=true

# ---------------------------------------------------------------------------
# AEO (Answer Engine Optimization)
# ---------------------------------------------------------------------------
# The module asks each configured answer engine the tracked prompts and records
# whether the brand was mentioned. An engine takes part in a run ONLY when its
# API key is set below (the custom engine: when its base URL is set), so a
# deployment that configures nothing still boots — POST /aeo/runs then answers
# 503 PROVIDERS_UNAVAILABLE. GET /aeo/providers lists every engine, configured
# or not. Keys are never logged.

# Anthropic. Also the engine behind POST /aeo/prompts/generate, which answers
# 503 PROVIDER_NOT_CONFIGURED when this key is missing.
# ANTHROPIC_API_KEY=
# AEO_ANTHROPIC_MODEL=claude-opus-5

# OpenAI (uses the SDK's default base URL).
# OPENAI_API_KEY=
# AEO_OPENAI_MODEL=gpt-4o-mini

# Google Gemini, through its OpenAI-compatible endpoint.
# GEMINI_API_KEY=
# AEO_GEMINI_MODEL=gemini-2.5-flash

# Moonshot Kimi, through its OpenAI-compatible endpoint.
# MOONSHOT_API_KEY=
# AEO_KIMI_MODEL=moonshot-v1-8k

# Perplexity. The only engine that returns citations natively; for every other
# engine citations are extracted from the answer text.
# PERPLEXITY_API_KEY=
# AEO_PERPLEXITY_MODEL=sonar

# Custom OpenAI-compatible engine (LM Studio, vLLM, Ollama, TGI, ...). Enabled
# by AEO_CUSTOM_BASE_URL alone; self-hosted servers usually need no key. The
# name is what gets stored in aeo_answers.provider and keyed on in the charts.
# AEO_CUSTOM_NAME=custom
# AEO_CUSTOM_BASE_URL=http://10.0.1.21:1234/v1
# AEO_CUSTOM_MODEL=openai/gpt-oss-20b
# AEO_CUSTOM_API_KEY=

# Daily scheduled run. Enabled by default; the hour is local server time and is
# clamped to 0..23. The scheduler is skipped entirely when no engine is
# configured, and a tick that lands while a run is still going is dropped
# (one run at a time).
# AEO_SCHEDULE_ENABLED=true
# AEO_SCHEDULE_HOUR=6

# Per-query deadline in seconds (default 60). Hosted APIs answer well inside
# it; a single-GPU self-hosted server (LM Studio, Ollama) answers serially, so
# queued queries carry the wait in their latency — raise this (e.g. 240) if
# answers come back as "context deadline exceeded".
# AEO_QUERY_TIMEOUT_SECONDS=60
